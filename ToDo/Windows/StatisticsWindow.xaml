<Window x:Class="ToDo.Windows.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика задач" Height="360" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Статистика задач" FontSize="18" FontWeight="Bold" Margin="0 0 0 16" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего задач:" Margin="0 4" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalTasks}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Новые:" Margin="0 4" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding New}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="В процессе:" Margin="0 4" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InProgress}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Выполнены:" Margin="0 4" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Completed}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Важные:" Margin="0 4" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Important}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Просрочено:" Margin="0 4" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Expired}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Сегодня:" Margin="0 4" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Today}" Margin="16 4 0 4" FontWeight="Bold" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="До конца недели:" Margin="0 4" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DueThisWeek}" Margin="16 4 0 4" FontWeight="Bold" />
        </Grid>

        <Button Grid.Row="2" Content="Закрыть" Width="90" Height="30" HorizontalAlignment="Right" Margin="0 16 0 0" Click="BtnClose_Click"/>
    </Grid>
</Window>
